37192>>>        Set pePosition to wiFit
37193>>>        Set piColumnIndex to 1
37194>>>        Set piHeight to 160
37195>>>        
37195>>>        WebSetResponsive piHeight rmMobile to 100  // Best for small smart phones
37196>>>    End_Object
37197>>>    
37197>>>    Object oLoginName is a cWebForm
37199>>>        Set psLabel to "User ID:"
37200>>>        Set peLabelPosition to lpTop
