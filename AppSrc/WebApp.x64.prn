36811>>>>>>>Class cPasswordHasher is a cObject
36812>>>>>>>    
36812>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36813>>>>>>>    
36813>>>>>>>    Procedure Construct_Object
36815>>>>>>>        Forward Send Construct_Object
36817>>>>>>>        
36817>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36818>>>>>>>        Property UInteger   puiSaltSize         16
36819>>>>>>>        
36819>>>>>>>        Property UInteger   puiOptTimeCost      420000
36820>>>>>>>    End_Procedure
36821>>>>>>>    
36821>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36823>>>>>>>        Boolean bOk
36823>>>>>>>        UInteger uiAlgo
36823>>>>>>>        Get peAlgorithm to uiAlgo
36824>>>>>>>        
36824>>>>>>>        Case Begin
36824>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36826>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36829>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36830>>>>>>>                Case Break
36831>>>>>>>            Case Else
36831>>>>>>>                Error 8710 "Invalid algorithm selected."
36832>>>>>>>>
36832>>>>>>>                Function_Return False
36833>>>>>>>        Case End
36833>>>>>>>        
36833>>>>>>>        Function_Return bOk
36834>>>>>>>    End_Function
36835>>>>>>>    
36835>>>>>>>    Function RequiredBufferSize Returns UBigInt
36837>>>>>>>        UBigInt ullSize
36837>>>>>>>        UInteger uiAlgo
36837>>>>>>>        Get peAlgorithm to uiAlgo
36838>>>>>>>        
36838>>>>>>>        Case Begin
36838>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36840>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36843>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36844>>>>>>>                Case Break
36845>>>>>>>            Case Else
36845>>>>>>>                Error 8710 "Invalid algorithm selected."
36846>>>>>>>>
36846>>>>>>>                Function_Return 0
36847>>>>>>>        Case End
36847>>>>>>>        
36847>>>>>>>        Function_Return ullSize
36848>>>>>>>    End_Function
36849>>>>>>>
36849>>>>>>>End_Class
