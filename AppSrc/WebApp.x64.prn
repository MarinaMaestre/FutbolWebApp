37226>>>    Object oLoginButton is a cWebButton
37228>>>        Set pbShowLabel to False
37229>>>        Set psCaption to "sign in"
37230>>>        Set pbServerOnClick to True
37231>>>        Set piColumnSpan to 10
37232>>>        Set piColumnIndex to 1
