38493>>>
38493>>>            Case (NavigateData.eNavigateType = nfFromMain)
38496>>>                // If from main, this is a probably a main-file lookup from a Zoom
38496>>>                WebSet pbRender of oDetailButton to False
38497>>>                Case Break
38498>>>
38498>>>            Case Else // must be nfUndefined
38498>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38498>>>
38498>>>        Case End
38498>>>
38498>>>    End_Procedure
38499>>>
38499>>>
38499>>>End_Object 
