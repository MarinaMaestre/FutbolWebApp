37010>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37012>>>>>        Handle hoUserDD
37012>>>>>        Integer iErr
37012>>>>>        Get phoUserDD to hoUserDD
37013>>>>>        
37013>>>>>        //  Find the user
37013>>>>>        Send Clear of hoUserDD
37014>>>>>        Move sLoginName to WebAppUser.LoginName
37015>>>>>        Send Find of hoUserDD EQ Index.1
37016>>>>>        If (Found) Begin
37018>>>>>            Send Clear of hoUserDD
37019>>>>>            Function_Return False
37020>>>>>        End
37020>>>>>>
37020>>>>>        
37020>>>>>        Send Clear of hoUserDD
37021>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37022>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37023>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37025>>>>>            Send Clear of hoUserDD
37026>>>>>            Function_Return False
37027>>>>>        End
37027>>>>>>
37027>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37028>>>>>        Get Request_Validate of hoUserDD to iErr
37029>>>>>        If (iErr) Begin
37031>>>>>            Send Clear of hoUserDD
37032>>>>>            Function_Return False
37033>>>>>        End
37033>>>>>>
37033>>>>>        
37033>>>>>        Send Request_Save of hoUserDD
37034>>>>>        Function_Return (not(Err))
37035>>>>>    End_Function
37036>>>>>    
37036>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37038>>>>>        String sSessionKey sUserPassword
37038>>>>>        Handle hoSessionDD hoUserDD
37038>>>>>        Boolean bMatch bUpgrade
37038>>>>>        
37038>>>>>        Get phoSessionDD to hoSessionDD
37039>>>>>        Get phoUserDD to hoUserDD
37040>>>>>        Integer iErr eLoginMode
37040>>>>>        
37040>>>>>        // Refind session record
37040>>>>>        Get psSessionKey to sSessionKey
37041>>>>>        Send Clear of hoSessionDD
37042>>>>>        Move sSessionKey to WebAppSession.SessionKey
37043>>>>>        Send Find of hoSessionDD EQ Index.1
37044>>>>>        
37044>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37046>>>>>            Get peLoginMode to eLoginMode
37047>>>>>            
37047>>>>>            //  Find the user
37047>>>>>            Move sLoginName to WebAppUser.LoginName
37048>>>>>            Send Find of hoUserDD EQ Index.1
37049>>>>>            
37049>>>>>            // Check username and password
37049>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37051>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37052>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37053>>>>>                
37053>>>>>                If (bMatch) Begin
37055>>>>>                    // Store the login
37055>>>>>                    If (bUpgrade) Begin
37057>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37058>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37061>>>>>                    End
37061>>>>>>
37061>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37062>>>>>                    Get Request_Validate of hoSessionDD to iErr
37063>>>>>                    If (iErr) Begin
37065>>>>>                        // this should not happen. If it does its a programming error
37065>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37066>>>>>>
37066>>>>>                        Function_Return False
37067>>>>>                    End
37067>>>>>>
37067>>>>>                    
37067>>>>>                    Send Request_Save of hoSessionDD
37068>>>>>                    
37068>>>>>                    // Update session properties
37068>>>>>                    Send UpdateSessionProperties False
37069>>>>>                    Send NotifyChangeRights
37070>>>>>                    Function_Return True
37071>>>>>                End
37071>>>>>>
37071>>>>>                Else Begin
37072>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37072>>>>>                    Send Clear of hoUserDD
37073>>>>>                End
37073>>>>>>
37073>>>>>            End
37073>>>>>>
37073>>>>>            Else Begin
37074>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37074>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37075>>>>>            End
37075>>>>>>
37075>>>>>        End
37075>>>>>>
37075>>>>>        Else Begin
37076>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37076>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37077>>>>>        End
37077>>>>>>
37077>>>>>          
37077>>>>>        Function_Return False
37078>>>>>    End_Function
