36552>>>>>>>    //
36552>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36554>>>>>>>        String sHours sMinutes sSeconds
36554>>>>>>>        
36554>>>>>>>        //  Extract parts
36554>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36555>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36556>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36557>>>>>>>        
36557>>>>>>>        //  Set to DateTime
36557>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36558>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36559>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36560>>>>>>>        
36560>>>>>>>        Function_Return dtTime
36561>>>>>>>    End_Function
