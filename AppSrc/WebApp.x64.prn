36637>>>>>>>    //
36637>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36639>>>>>>>        String sHours sMinutes sSeconds
36639>>>>>>>        
36639>>>>>>>        //  Extract parts
36639>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36640>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36641>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36642>>>>>>>        
36642>>>>>>>        //  Set to DateTime
36642>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36643>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36644>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36645>>>>>>>        
36645>>>>>>>        Function_Return dtTime
36646>>>>>>>    End_Function
