36621>>>>>>>    //
36621>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36621>>>>>>>    //
36621>>>>>>>    //  Params:
36621>>>>>>>    //      dtTime  Time to convert
36621>>>>>>>    //  Returns:
36621>>>>>>>    //      String with "HH:MM:SS" format
36621>>>>>>>    //
36621>>>>>>>    Function TimeToString DateTime dtTime Returns String
36623>>>>>>>        String sHours sMinutes sSeconds
36623>>>>>>>        
36623>>>>>>>        //  Extract parts
36623>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36624>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36625>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36626>>>>>>>        
36626>>>>>>>        //  Fill out with 0
36626>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36629>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36632>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36635>>>>>>>        
36635>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36636>>>>>>>    End_Function
