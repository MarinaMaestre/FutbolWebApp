36536>>>>>>>    //
36536>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36536>>>>>>>    //
36536>>>>>>>    //  Params:
36536>>>>>>>    //      dtTime  Time to convert
36536>>>>>>>    //  Returns:
36536>>>>>>>    //      String with "HH:MM:SS" format
36536>>>>>>>    //
36536>>>>>>>    Function TimeToString DateTime dtTime Returns String
36538>>>>>>>        String sHours sMinutes sSeconds
36538>>>>>>>        
36538>>>>>>>        //  Extract parts
36538>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36539>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36540>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36541>>>>>>>        
36541>>>>>>>        //  Fill out with 0
36541>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36544>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36547>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36550>>>>>>>        
36550>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36551>>>>>>>    End_Function
