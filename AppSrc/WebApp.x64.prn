37162>>>    Set piMinWidth to 250
37163>>>    Set piMaxWidth to 420
37164>>>    Set pbLoginModeEnforced to False
37165>>>    Set piColumnCount to 12
37166>>>    Set psCSSClass to "LoginView"
37167>>>    Set pbServerOnSubmit to True
37168>>>    
37168>>>    Set psStateViewName to "Login"
37169>>>    Set pbStateReplace to True  // Always replace the state so the login never becomes its own history item
37170>>>    
37170>>>    Property String psPrevStateHash ""  // Remember the state hash that the user navigated too so we can redirect after login
37173>>>    
37173>>>    Delegate Set phoLoginView to Self
37175>>>    
