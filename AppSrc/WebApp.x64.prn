36850>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36851>>>>>    
36851>>>>>    Procedure Construct_Object
36853>>>>>        Handle hoObj
36853>>>>>        
36853>>>>>        Forward Send Construct_Object
36855>>>>>        
36855>>>>>        Set pbSessionCookieHttpOnly to True
36856>>>>>        
36856>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36857>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36858>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36859>>>>>        
36859>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36860>>>>>        Set phoUserDD to hoObj
36861>>>>>        
36861>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36862>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36863>>>>>        Set phoSessionDD to hoObj
36864>>>>>        
36864>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36865>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36866>>>>>        Set phoCrypto to hoObj
36867>>>>>        
36867>>>>>        Property Boolean pbPasswordHashing True
36868>>>>>        
36868>>>>>        Property Boolean pbCreatingNewSession False
36869>>>>>        Property String psLoginName
36870>>>>>        Property String psUserName ""
36871>>>>>        Property Integer piUserRights 0
36872>>>>>    End_Procedure
36873>>>>>    
36873>>>>>    Procedure End_Construct_Object
36875>>>>>        Forward Send End_Construct_Object
36877>>>>>        
36877>>>>>        Handle hoCrypto
36877>>>>>        Integer iFieldLen
36877>>>>>        If (pbPasswordHashing(Self)) Begin
36879>>>>>            Get phoCrypto to hoCrypto
36880>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36883>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36885>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36886>>>>>>
36886>>>>>            End
36886>>>>>>
36886>>>>>        End
36886>>>>>>
36886>>>>>    End_Procedure
36887>>>>>    
36887>>>>>    Function CreateSession String sRemoteAddress Returns String
36889>>>>>        String sSessionKey
36889>>>>>        Integer iErr
36889>>>>>        Boolean bLogWebSession
36889>>>>>        Handle hoSessionDD       
36889>>>>>        Get phoSessionDD to hoSessionDD
36890>>>>>        
36890>>>>>        //  Get session key
36890>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36892>>>>>        
36892>>>>>        Get pbLogWebSession to bLogWebSession
36893>>>>>        If not bLogWebSession Begin
36895>>>>>            Function_Return sSessionKey        
36896>>>>>        End
36896>>>>>>
36896>>>>>
36896>>>>>        //  Store session
36896>>>>>        Send Clear of hoSessionDD
36897>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36898>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36899>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36900>>>>>        Get Request_Validate of hoSessionDD to iErr
36901>>>>>        If (iErr) Begin
36903>>>>>            // this should not happen. If it does its a programming error
36903>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36904>>>>>>
36904>>>>>            Function_Return ""
36905>>>>>        End
36905>>>>>>
36905>>>>>        Send Request_Save of hoSessionDD
36906>>>>>        If (Err) Begin
36908>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36908>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36909>>>>>>
36909>>>>>            Function_Return ""
36910>>>>>        End
36910>>>>>>
36910>>>>>       
36910>>>>>        Function_Return sSessionKey        
36911>>>>>    End_Function
36912>>>>>    
36912>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36914>>>>>        DateTime dtLastAccess dtCurrent
36914>>>>>        TimeSpan tsDiff
36914>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36914>>>>>        Boolean bResult bCreatingNewSession
36914>>>>>        Boolean bLogWebSession bLoadWebApp
36914>>>>>        Integer eLoginMode
36914>>>>>        String sTime
36914>>>>>        Handle hoSessionDD hoUserDD       
36914>>>>>        
36914>>>>>        Move False to bLoadWebApp
36915>>>>>        If (num_arguments >= 2) Begin
36917>>>>>            Move bOptLoadWebApp to bLoadWebApp
36918>>>>>        End
36918>>>>>>
36918>>>>>        
36918>>>>>        Get phoSessionDD to hoSessionDD
36919>>>>>        Get phoUserDD to hoUserDD
36920>>>>>        
36920>>>>>        Get pbLogWebSession to bLogWebSession
36921>>>>>        Get peLoginMode to eLoginMode
36922>>>>>        
36922>>>>>        // for this object, you can only disable logging if login completely is disabled
36922>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36924>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36925>>>>>>
36925>>>>>            Function_Return False
36926>>>>>        End
36926>>>>>>
36926>>>>>
36926>>>>>        //  Clear session properties
36926>>>>>        Set psSessionKey to ""
36927>>>>>        Send UpdateSessionProperties True
36928>>>>>        
36928>>>>>        If not bLogWebSession Begin
36930>>>>>            Forward Get ValidateSession sSessionKey to bResult
36932>>>>>            Function_Return bResult
36933>>>>>        End        
36933>>>>>>
36933>>>>>        
36933>>>>>        Move False to bResult
36934>>>>>        Get piSessionTimeout to iSessionTimeout 
36935>>>>>        
36935>>>>>        //  Check if session exists
36935>>>>>        Send Clear of hoSessionDD
36936>>>>>        Move sSessionKey to WebAppSession.SessionKey
36937>>>>>        Send Find of hoSessionDD EQ Index.1
36938>>>>>            
36938>>>>>        If (Found) Begin
36940>>>>>            //  Calculate timespan between now and last access time
36940>>>>>            Move (CurrentDateTime()) to dtCurrent
36941>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36942>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36943>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36944>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36945>>>>>            
36945>>>>>            //  Check if session didn't time out
36945>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36947>>>>>                Forward Get ValidateSession sSessionKey to bResult
36949>>>>>                   
36949>>>>>                If (bResult) Begin
36951>>>>>                    //  Update session record
36951>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36952>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36953>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36954>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36955>>>>>                    Get Request_Validate of hoSessionDD to iErr
36956>>>>>                    If (iErr) Begin
36958>>>>>                        // this should not happen. If it does its a programming error
36958>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36959>>>>>>
36959>>>>>                        Function_Return False
36960>>>>>                    End
36960>>>>>>
36960>>>>>                    Send Request_Save of hoSessionDD
36961>>>>>                    
36961>>>>>                    //  Update user properties
36961>>>>>                    Send UpdateSessionProperties False
36962>>>>>                End
36962>>>>>>
36962>>>>>            End
36962>>>>>>
36962>>>>>            Else Begin
36963>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36963>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36964>>>>>                
36964>>>>>                If (not(bCreatingNewSession)) Begin
36966>>>>>                    If (not(bLoadWebApp)) Begin
36968>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36969>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36970>>>>>>
36970>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36971>>>>>                    End
36971>>>>>>
36971>>>>>                    Else Begin
36972>>>>>                        Set pbCreatingNewSession to True                    
36973>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36974>>>>>                        Set pbCreatingNewSession to False                        
36975>>>>>                    End
36975>>>>>>
36975>>>>>                End
36975>>>>>>
36975>>>>>            End
36975>>>>>>
36975>>>>>        End
36975>>>>>>
36975>>>>>        Else Begin
36976>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36977>>>>>>
36977>>>>>        End
36977>>>>>>
36977>>>>>        
36977>>>>>        Function_Return bResult
36978>>>>>    End_Function
36979>>>>>    
36979>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36981>>>>>        If (not(pbPasswordHashing(Self))) Begin
36983>>>>>            Move sPassword to sHash
36984>>>>>            Function_Return True
36985>>>>>        End
36985>>>>>>
36985>>>>>        
36985>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
36987>>>>>            Function_Return False
36988>>>>>        End
36988>>>>>>
36988>>>>>        Move ("V1$" + sHash) to sHash
36989>>>>>        Function_Return True
36990>>>>>    End_Function
36991>>>>>    
36991>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
36993>>>>>        If (not(pbPasswordHashing(Self))) Begin
36995>>>>>            Move False to bShouldUpgrade
36996>>>>>            Function_Return (sUserPassword = sEnteredPassword)
36997>>>>>        End
36997>>>>>>
36997>>>>>        
36997>>>>>        String sVersion
36997>>>>>        Move (Left(sUserPassword, 3)) to sVersion
36998>>>>>        If (sVersion = "V1$") Begin
37000>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37003>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37004>>>>>        End
37004>>>>>>
37004>>>>>        Else Begin
37005>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37008>>>>>            Function_Return False
37009>>>>>        End
37009>>>>>>
37009>>>>>    End_Function
