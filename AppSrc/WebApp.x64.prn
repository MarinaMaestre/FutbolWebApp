36759>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36762>>>>>>>        
36762>>>>>>>        // Base64Decode
36762>>>>>>>        UChar[] ucaSalt
36763>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36764>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36767>>>>>>>        
36767>>>>>>>        // Create new hash
36767>>>>>>>        String sNewHash
36767>>>>>>>        If (bRequiresTimeCost) Begin
36769>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36771>>>>>>>                Function_Return False 
36772>>>>>>>            End
36772>>>>>>>>
36772>>>>>>>        End
36772>>>>>>>>
36772>>>>>>>        Else Begin
36773>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36775>>>>>>>                Function_Return False 
36776>>>>>>>            End
36776>>>>>>>>
36776>>>>>>>        End
36776>>>>>>>>
36776>>>>>>>        Function_Return (sNewHash = sHash)
36777>>>>>>>    End_Function
36778>>>>>>>    
36778>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36780>>>>>>>        Boolean bRequireTimeCost
36780>>>>>>>        UBigInt ullSize
36780>>>>>>>        UChar[] ucaSalt
36781>>>>>>>        String sSalt
36781>>>>>>>        
36781>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36782>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36783>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36786>>>>>>>        
36786>>>>>>>        Case Begin
36786>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36788>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36789>>>>>>>                Move True to bRequireTimeCost
36790>>>>>>>                Case Break
36791>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36794>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36795>>>>>>>                Move True to bRequireTimeCost
36796>>>>>>>                Case Break
36797>>>>>>>            Case Else
36797>>>>>>>                Error 8710 "Invalid algorithm selected."
36798>>>>>>>>
36798>>>>>>>                Function_Return 0
36799>>>>>>>        Case End
36799>>>>>>>        
36799>>>>>>>        // calculate base64 in a non-floating-manner
36799>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36800>>>>>>>        
36800>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36801>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36802>>>>>>>        If (bRequireTimeCost) Begin
36804>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36805>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36806>>>>>>>        End
36806>>>>>>>>
36806>>>>>>>        Else Begin
36807>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36808>>>>>>>        End
36808>>>>>>>>
36808>>>>>>>        
36808>>>>>>>        Function_Return ullSize
36809>>>>>>>    End_Function
36810>>>>>>>End_Class
