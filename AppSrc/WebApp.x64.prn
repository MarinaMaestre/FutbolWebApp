36811>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36813>>>>>>>        Boolean bRequiresTimeCost
36813>>>>>>>        UInteger uiAlgo uiTimeCost
36813>>>>>>>        Integer iBegin iEnd
36813>>>>>>>        String sSalt
36813>>>>>>>        
36813>>>>>>>        Move 1 to iBegin
36814>>>>>>>        
36814>>>>>>>        // Parse Algo
36814>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36815>>>>>>>        If (not(iEnd)) Function_Return False
36818>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36819>>>>>>>        
36819>>>>>>>        // Parse Salt
36819>>>>>>>        Move (iEnd + 1) to iBegin
36820>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36821>>>>>>>        If (not(iEnd)) Function_Return False
36824>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36825>>>>>>>        
36825>>>>>>>        Case Begin
36825>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36827>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36830>>>>>>>                Move True to bRequiresTimeCost
36831>>>>>>>                Case Break
36832>>>>>>>            Case Else
36832>>>>>>>                Error 8710 "Invalid algorithm selected."
36833>>>>>>>>
36833>>>>>>>                Function_Return False
36834>>>>>>>        Case End
36834>>>>>>>        
36834>>>>>>>        // Parse optional timecost
36834>>>>>>>        If (bRequiresTimeCost) Begin
36836>>>>>>>            Move (iEnd + 1) to iBegin
36837>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36838>>>>>>>            If (not(iEnd)) Function_Return False
36841>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36842>>>>>>>        End
36842>>>>>>>>
36842>>>>>>>        
36842>>>>>>>        // Parse rest hash
36842>>>>>>>        Move (iEnd + 1) to iBegin
36843>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36844>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36847>>>>>>>        
36847>>>>>>>        // Base64Decode
36847>>>>>>>        UChar[] ucaSalt
36848>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36849>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36852>>>>>>>        
36852>>>>>>>        // Create new hash
36852>>>>>>>        String sNewHash
36852>>>>>>>        If (bRequiresTimeCost) Begin
36854>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36856>>>>>>>                Function_Return False 
36857>>>>>>>            End
36857>>>>>>>>
36857>>>>>>>        End
36857>>>>>>>>
36857>>>>>>>        Else Begin
36858>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36860>>>>>>>                Function_Return False 
36861>>>>>>>            End
36861>>>>>>>>
36861>>>>>>>        End
36861>>>>>>>>
36861>>>>>>>        Function_Return (sNewHash = sHash)
36862>>>>>>>    End_Function
36863>>>>>>>    
36863>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36865>>>>>>>        Boolean bRequireTimeCost
36865>>>>>>>        UBigInt ullSize
36865>>>>>>>        UChar[] ucaSalt
36866>>>>>>>        String sSalt
36866>>>>>>>        
36866>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36867>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36868>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36871>>>>>>>        
36871>>>>>>>        Case Begin
36871>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36873>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36874>>>>>>>                Move True to bRequireTimeCost
36875>>>>>>>                Case Break
36876>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36879>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36880>>>>>>>                Move True to bRequireTimeCost
36881>>>>>>>                Case Break
36882>>>>>>>            Case Else
36882>>>>>>>                Error 8710 "Invalid algorithm selected."
36883>>>>>>>>
36883>>>>>>>                Function_Return 0
36884>>>>>>>        Case End
36884>>>>>>>        
36884>>>>>>>        // calculate base64 in a non-floating-manner
36884>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36885>>>>>>>        
36885>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36886>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36887>>>>>>>        If (bRequireTimeCost) Begin
36889>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36890>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36891>>>>>>>        End
36891>>>>>>>>
36891>>>>>>>        Else Begin
36892>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36893>>>>>>>        End
36893>>>>>>>>
36893>>>>>>>        
36893>>>>>>>        Function_Return ullSize
36894>>>>>>>    End_Function
36895>>>>>>>End_Class
36896>>>>>>>
36896>>>>>>>Class cPasswordHasher is a cObject
36897>>>>>>>    
36897>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36898>>>>>>>    
36898>>>>>>>    Procedure Construct_Object
36900>>>>>>>        Forward Send Construct_Object
36902>>>>>>>        
36902>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36903>>>>>>>        Property UInteger   puiSaltSize         16
36904>>>>>>>        
36904>>>>>>>        Property UInteger   puiOptTimeCost      420000
36905>>>>>>>    End_Procedure
36906>>>>>>>    
36906>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36908>>>>>>>        Boolean bOk
36908>>>>>>>        UInteger uiAlgo
36908>>>>>>>        Get peAlgorithm to uiAlgo
36909>>>>>>>        
36909>>>>>>>        Case Begin
36909>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36911>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36914>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36915>>>>>>>                Case Break
36916>>>>>>>            Case Else
36916>>>>>>>                Error 8710 "Invalid algorithm selected."
36917>>>>>>>>
36917>>>>>>>                Function_Return False
36918>>>>>>>        Case End
36918>>>>>>>        
36918>>>>>>>        Function_Return bOk
36919>>>>>>>    End_Function
36920>>>>>>>    
36920>>>>>>>    Function RequiredBufferSize Returns UBigInt
36922>>>>>>>        UBigInt ullSize
36922>>>>>>>        UInteger uiAlgo
36922>>>>>>>        Get peAlgorithm to uiAlgo
36923>>>>>>>        
36923>>>>>>>        Case Begin
36923>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36925>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36928>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36929>>>>>>>                Case Break
36930>>>>>>>            Case Else
36930>>>>>>>                Error 8710 "Invalid algorithm selected."
36931>>>>>>>>
36931>>>>>>>                Function_Return 0
36932>>>>>>>        Case End
36932>>>>>>>        
36932>>>>>>>        Function_Return ullSize
36933>>>>>>>    End_Function
36934>>>>>>>
36934>>>>>>>End_Class
36935>>>>>
36935>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36936>>>>>    
36936>>>>>    Procedure Construct_Object
36938>>>>>        Handle hoObj
36938>>>>>        
36938>>>>>        Forward Send Construct_Object
36940>>>>>        
36940>>>>>        Set pbSessionCookieHttpOnly to True
36941>>>>>        
36941>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36942>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36943>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36944>>>>>        
36944>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36945>>>>>        Set phoUserDD to hoObj
36946>>>>>        
36946>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36947>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36948>>>>>        Set phoSessionDD to hoObj
36949>>>>>        
36949>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36950>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36951>>>>>        Set phoCrypto to hoObj
36952>>>>>        
36952>>>>>        Property Boolean pbPasswordHashing True
36953>>>>>        
36953>>>>>        Property Boolean pbCreatingNewSession False
36954>>>>>        Property String psLoginName
36955>>>>>        Property String psUserName ""
36956>>>>>        Property Integer piUserRights 0
36957>>>>>    End_Procedure
36958>>>>>    
36958>>>>>    Procedure End_Construct_Object
36960>>>>>        Forward Send End_Construct_Object
36962>>>>>        
36962>>>>>        Handle hoCrypto
36962>>>>>        Integer iFieldLen
36962>>>>>        If (pbPasswordHashing(Self)) Begin
36964>>>>>            Get phoCrypto to hoCrypto
36965>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36968>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36970>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36971>>>>>>
36971>>>>>            End
36971>>>>>>
36971>>>>>        End
36971>>>>>>
36971>>>>>    End_Procedure
36972>>>>>    
36972>>>>>    Function CreateSession String sRemoteAddress Returns String
36974>>>>>        String sSessionKey
36974>>>>>        Integer iErr
36974>>>>>        Boolean bLogWebSession
36974>>>>>        Handle hoSessionDD       
36974>>>>>        Get phoSessionDD to hoSessionDD
36975>>>>>        
36975>>>>>        //  Get session key
36975>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36977>>>>>        
36977>>>>>        Get pbLogWebSession to bLogWebSession
36978>>>>>        If not bLogWebSession Begin
36980>>>>>            Function_Return sSessionKey        
36981>>>>>        End
36981>>>>>>
36981>>>>>
36981>>>>>        //  Store session
36981>>>>>        Send Clear of hoSessionDD
36982>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36983>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36984>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36985>>>>>        Get Request_Validate of hoSessionDD to iErr
36986>>>>>        If (iErr) Begin
36988>>>>>            // this should not happen. If it does its a programming error
36988>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36989>>>>>>
36989>>>>>            Function_Return ""
36990>>>>>        End
36990>>>>>>
36990>>>>>        Send Request_Save of hoSessionDD
36991>>>>>        If (Err) Begin
36993>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36993>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36994>>>>>>
36994>>>>>            Function_Return ""
36995>>>>>        End
36995>>>>>>
36995>>>>>       
36995>>>>>        Function_Return sSessionKey        
36996>>>>>    End_Function
36997>>>>>    
36997>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36999>>>>>        DateTime dtLastAccess dtCurrent
36999>>>>>        TimeSpan tsDiff
36999>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36999>>>>>        Boolean bResult bCreatingNewSession
36999>>>>>        Boolean bLogWebSession bLoadWebApp
36999>>>>>        Integer eLoginMode
36999>>>>>        String sTime
36999>>>>>        Handle hoSessionDD hoUserDD       
36999>>>>>        
36999>>>>>        Move False to bLoadWebApp
37000>>>>>        If (num_arguments >= 2) Begin
37002>>>>>            Move bOptLoadWebApp to bLoadWebApp
37003>>>>>        End
37003>>>>>>
37003>>>>>        
37003>>>>>        Get phoSessionDD to hoSessionDD
37004>>>>>        Get phoUserDD to hoUserDD
37005>>>>>        
37005>>>>>        Get pbLogWebSession to bLogWebSession
37006>>>>>        Get peLoginMode to eLoginMode
37007>>>>>        
37007>>>>>        // for this object, you can only disable logging if login completely is disabled
37007>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
37009>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
37010>>>>>>
37010>>>>>            Function_Return False
37011>>>>>        End
37011>>>>>>
37011>>>>>
37011>>>>>        //  Clear session properties
37011>>>>>        Set psSessionKey to ""
37012>>>>>        Send UpdateSessionProperties True
37013>>>>>        
37013>>>>>        If not bLogWebSession Begin
37015>>>>>            Forward Get ValidateSession sSessionKey to bResult
37017>>>>>            Function_Return bResult
37018>>>>>        End        
37018>>>>>>
37018>>>>>        
37018>>>>>        Move False to bResult
37019>>>>>        Get piSessionTimeout to iSessionTimeout 
37020>>>>>        
37020>>>>>        //  Check if session exists
37020>>>>>        Send Clear of hoSessionDD
37021>>>>>        Move sSessionKey to WebAppSession.SessionKey
37022>>>>>        Send Find of hoSessionDD EQ Index.1
37023>>>>>            
37023>>>>>        If (Found) Begin
37025>>>>>            //  Calculate timespan between now and last access time
37025>>>>>            Move (CurrentDateTime()) to dtCurrent
37026>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
37027>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
37028>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
37029>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
37030>>>>>            
37030>>>>>            //  Check if session didn't time out
37030>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
37032>>>>>                Forward Get ValidateSession sSessionKey to bResult
37034>>>>>                   
37034>>>>>                If (bResult) Begin
37036>>>>>                    //  Update session record
37036>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
37037>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
37038>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
37039>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
37040>>>>>                    Get Request_Validate of hoSessionDD to iErr
37041>>>>>                    If (iErr) Begin
37043>>>>>                        // this should not happen. If it does its a programming error
37043>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37044>>>>>>
37044>>>>>                        Function_Return False
37045>>>>>                    End
37045>>>>>>
37045>>>>>                    Send Request_Save of hoSessionDD
37046>>>>>                    
37046>>>>>                    //  Update user properties
37046>>>>>                    Send UpdateSessionProperties False
37047>>>>>                End
37047>>>>>>
37047>>>>>            End
37047>>>>>>
37047>>>>>            Else Begin
37048>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
37048>>>>>                Get pbCreatingNewSession to bCreatingNewSession
37049>>>>>                
37049>>>>>                If (not(bCreatingNewSession)) Begin
37051>>>>>                    If (not(bLoadWebApp)) Begin
37053>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
37054>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
37055>>>>>>
37055>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
37056>>>>>                    End
37056>>>>>>
37056>>>>>                    Else Begin
37057>>>>>                        Set pbCreatingNewSession to True                    
37058>>>>>                        Get RecreateSession of ghoWebApp to bResult 
37059>>>>>                        Set pbCreatingNewSession to False                        
37060>>>>>                    End
37060>>>>>>
37060>>>>>                End
37060>>>>>>
37060>>>>>            End
37060>>>>>>
37060>>>>>        End
37060>>>>>>
37060>>>>>        Else Begin
37061>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
37062>>>>>>
37062>>>>>        End
37062>>>>>>
37062>>>>>        
37062>>>>>        Function_Return bResult
37063>>>>>    End_Function
37064>>>>>    
37064>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
37066>>>>>        If (not(pbPasswordHashing(Self))) Begin
37068>>>>>            Move sPassword to sHash
37069>>>>>            Function_Return True
37070>>>>>        End
37070>>>>>>
37070>>>>>        
37070>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
37072>>>>>            Function_Return False
37073>>>>>        End
37073>>>>>>
37073>>>>>        Move ("V1$" + sHash) to sHash
37074>>>>>        Function_Return True
37075>>>>>    End_Function
37076>>>>>    
37076>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37078>>>>>        If (not(pbPasswordHashing(Self))) Begin
37080>>>>>            Move False to bShouldUpgrade
37081>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37082>>>>>        End
37082>>>>>>
37082>>>>>        
37082>>>>>        String sVersion
37082>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37083>>>>>        If (sVersion = "V1$") Begin
37085>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37088>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37089>>>>>        End
37089>>>>>>
37089>>>>>        Else Begin
37090>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37093>>>>>            Function_Return False
37094>>>>>        End
37094>>>>>>
37094>>>>>    End_Function
37095>>>>>    
37095>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37097>>>>>        Handle hoUserDD
37097>>>>>        Integer iErr
37097>>>>>        Get phoUserDD to hoUserDD
37098>>>>>        
37098>>>>>        //  Find the user
37098>>>>>        Send Clear of hoUserDD
37099>>>>>        Move sLoginName to WebAppUser.LoginName
37100>>>>>        Send Find of hoUserDD EQ Index.1
37101>>>>>        If (Found) Begin
37103>>>>>            Send Clear of hoUserDD
37104>>>>>            Function_Return False
37105>>>>>        End
37105>>>>>>
37105>>>>>        
37105>>>>>        Send Clear of hoUserDD
37106>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37107>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37108>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37110>>>>>            Send Clear of hoUserDD
37111>>>>>            Function_Return False
37112>>>>>        End
37112>>>>>>
37112>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37113>>>>>        Get Request_Validate of hoUserDD to iErr
37114>>>>>        If (iErr) Begin
37116>>>>>            Send Clear of hoUserDD
37117>>>>>            Function_Return False
37118>>>>>        End
37118>>>>>>
37118>>>>>        
37118>>>>>        Send Request_Save of hoUserDD
37119>>>>>        Function_Return (not(Err))
37120>>>>>    End_Function
37121>>>>>    
37121>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37123>>>>>        String sSessionKey sUserPassword
37123>>>>>        Handle hoSessionDD hoUserDD
37123>>>>>        Boolean bMatch bUpgrade
37123>>>>>        
37123>>>>>        Get phoSessionDD to hoSessionDD
37124>>>>>        Get phoUserDD to hoUserDD
37125>>>>>        Integer iErr eLoginMode
37125>>>>>        
37125>>>>>        // Refind session record
37125>>>>>        Get psSessionKey to sSessionKey
37126>>>>>        Send Clear of hoSessionDD
37127>>>>>        Move sSessionKey to WebAppSession.SessionKey
37128>>>>>        Send Find of hoSessionDD EQ Index.1
37129>>>>>        
37129>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37131>>>>>            Get peLoginMode to eLoginMode
37132>>>>>            
37132>>>>>            //  Find the user
37132>>>>>            Move sLoginName to WebAppUser.LoginName
37133>>>>>            Send Find of hoUserDD EQ Index.1
37134>>>>>            
37134>>>>>            // Check username and password
37134>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37136>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37137>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37138>>>>>                
37138>>>>>                If (bMatch) Begin
37140>>>>>                    // Store the login
37140>>>>>                    If (bUpgrade) Begin
37142>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37143>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37146>>>>>                    End
37146>>>>>>
37146>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37147>>>>>                    Get Request_Validate of hoSessionDD to iErr
37148>>>>>                    If (iErr) Begin
37150>>>>>                        // this should not happen. If it does its a programming error
37150>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37151>>>>>>
37151>>>>>                        Function_Return False
37152>>>>>                    End
37152>>>>>>
37152>>>>>                    
37152>>>>>                    Send Request_Save of hoSessionDD
37153>>>>>                    
37153>>>>>                    // Update session properties
37153>>>>>                    Send UpdateSessionProperties False
37154>>>>>                    Send NotifyChangeRights
37155>>>>>                    Function_Return True
37156>>>>>                End
37156>>>>>>
37156>>>>>                Else Begin
37157>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37157>>>>>                    Send Clear of hoUserDD
37158>>>>>                End
37158>>>>>>
37158>>>>>            End
37158>>>>>>
37158>>>>>            Else Begin
37159>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37159>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37160>>>>>            End
37160>>>>>>
37160>>>>>        End
37160>>>>>>
37160>>>>>        Else Begin
37161>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37161>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37162>>>>>        End
37162>>>>>>
37162>>>>>          
37162>>>>>        Function_Return False
37163>>>>>    End_Function
37164>>>>>    
37164>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37166>>>>>        Handle hoUserDD
37166>>>>>        Integer iErr
37166>>>>>        Get phoUserDD to hoUserDD
37167>>>>>        
37167>>>>>        //  Find the user
37167>>>>>        Send Clear of hoUserDD
37168>>>>>        Move sLoginName to WebAppUser.LoginName
37169>>>>>        Send Find of hoUserDD EQ Index.1
37170>>>>>        If (not(Found)) Begin
37172>>>>>            Send Clear of hoUserDD
37173>>>>>            Function_Return False
37174>>>>>        End
37174>>>>>>
37174>>>>>        
37174>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37176>>>>>            Send Clear of hoUserDD
37177>>>>>            Function_Return False
37178>>>>>        End
37178>>>>>>
37178>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37179>>>>>        Get Request_Validate of hoUserDD to iErr
37180>>>>>        If (iErr) Begin
37182>>>>>            Send Clear of hoUserDD
37183>>>>>            Function_Return False
37184>>>>>        End
37184>>>>>>
37184>>>>>        
37184>>>>>        Send Request_Save of hoUserDD
37185>>>>>        Function_Return (not(Err))
37186>>>>>    End_Function
37187>>>>>    
37187>>>>>    Function IsLoggedIn Returns Boolean
37189>>>>>        String sLoginName
37189>>>>>        Boolean bLogWebSession bLoggedIn
37189>>>>>        
37189>>>>>        Get pbLogWebSession to bLogWebSession
37190>>>>>        If not bLogWebSession Begin
37192>>>>>            Forward Get IsLoggedIn to bLoggedIn
37194>>>>>            Function_Return bLoggedIn
37195>>>>>        End
37195>>>>>>
37195>>>>>        
37195>>>>>        Get psLoginName to sLoginName
37196>>>>>        
37196>>>>>        Function_Return (sLoginName <> "")
37197>>>>>    End_Function
37198>>>>>    
37198>>>>>    
37198>>>>>    //
37198>>>>>    // This procedure is called when validating a session and after logging in. Its purpose is to 
37198>>>>>    // update properties based on the session and user data. Augment this function to update 
37198>>>>>    // properties based on the session / user table. Note that WebAppUser and WebAppSession contain
37198>>>>>    // the right records when this procedure is called.
37198>>>>>    //
37198>>>>>    // Params:
37198>>>>>    //      bClear   True if the procedure is called before session validation to clear properties.
37198>>>>>    //
37198>>>>>    Procedure UpdateSessionProperties Boolean bClear
37200>>>>>        Handle hoUserDD
37200>>>>>        
37200>>>>>        Get phoUserDD to hoUserDD
37201>>>>>        
37201>>>>>        //  Update user properties
37201>>>>>        If (not(bClear) and HasRecord(hoUserDD)) Begin
37203>>>>>            Set psUsername to (Trim(WebAppUser.FullName))
37204>>>>>            Set psLoginName to (Trim(WebAppUser.LoginName))
37205>>>>>            Set piUserRights to WebAppUser.Rights
37206>>>>>            
37206>>>>>            Send OnSessionPropertiesSet 
37207>>>>>        End
37207>>>>>>
37207>>>>>        Else Begin
37208>>>>>            Set psUsername to ""
37209>>>>>            Set psLoginName to ""
37210>>>>>            Set piUserRights to 0
37211>>>>>            
37211>>>>>            Send OnSessionPropertiesClear
37212>>>>>        End
37212>>>>>>
37212>>>>>    End_Procedure
