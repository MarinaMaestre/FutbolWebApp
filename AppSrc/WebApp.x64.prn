38315>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38318>>>        Case Begin
38318>>>            Case (NavigateData.eNavigateType = nfFromMain)
38320>>>                // If from main, this is a propbably a main file Select to Zoom.
38320>>>                Case Break
38321>>>
38321>>>            Case (NavigateData.eNavigateType = nfFromParent)
38324>>>                // If from parent, this is a constrained drill down.
38324>>>                Case Break
38325>>>
38325>>>            Case (NavigateData.eNavigateType = nfFromChild)
38328>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38328>>>                Case Break
38329>>>
38329>>>            Case Else // must be nfUndefined
38329>>>
38329>>>        Case End
38329>>>
38329>>>        Send SetActionButtons
38330>>>
38330>>>    End_Procedure
38331>>>
38331>>>End_Object 
