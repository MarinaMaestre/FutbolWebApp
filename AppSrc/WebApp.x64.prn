37890>>>>>>>        Else Begin
37891>>>>>>>            WebSet pbRender of oSaveBtn to True
37892>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37893>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37894>>>>>>>        End
