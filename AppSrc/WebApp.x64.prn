37221>>>>>        Integer iErr
37221>>>>>        Boolean bLogWebSession
37221>>>>>        Handle hoSessionDD       
37221>>>>>        
37221>>>>>        Get phoSessionDD to hoSessionDD
37222>>>>>        Get pbLogWebSession to bLogWebSession
37223>>>>>        If not bLogWebSession Begin
37225>>>>>            Forward Send EndSession
37227>>>>>            Procedure_Return
37228>>>>>        End
37228>>>>>>
37228>>>>>            
37228>>>>>        //  Check if session exists
37228>>>>>        Send Clear of hoSessionDD
37229>>>>>        Get psSessionKey to WebAppSession.SessionKey
37230>>>>>        
37230>>>>>        Send Find of hoSessionDD EQ Index.1
37231>>>>>        If (Found) Begin
37233>>>>>            Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "N"
37234>>>>>            Get Request_Validate of hoSessionDD to iErr
37235>>>>>            If (iErr) Begin
37237>>>>>                // this should not happen. If it does its a programming error
37237>>>>>                Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37238>>>>>>
37238>>>>>                Procedure_Return
37239>>>>>            End
37239>>>>>>
37239>>>>>            Send Request_Save of hoSessionDD
37240>>>>>        End
37240>>>>>>
37240>>>>>    End_Procedure
