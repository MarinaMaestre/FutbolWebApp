37329>>>    Procedure DoLogin
37332>>>        String sLoginName sPassword sPrevStateHash
37332>>>        Boolean bResult
37332>>>        
37332>>>        WebGet psValue of oLoginName to sLoginName
37333>>>        WebGet psValue of oPassword to sPassword
37334>>>        
37334>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37335>>>        
37335>>>        If (bResult) Begin
37337>>>            Send Hide of oLogin
37338>>>            Send ShowHeader of ghoWebApp
37339>>>            WebSet psCSSClass of ghoWebApp to ""
37340>>>            
37340>>>            WebGet psPrevStateHash to sPrevStateHash
37341>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37342>>>            
37342>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37342>>>            WebSet psValue of oLoginName to ""
37343>>>            WebSet psValue of oPassword  to ""
37344>>>            WebSet pbVisible of oWarning to False
37345>>>        End
37345>>>>
37345>>>        Else Begin
37346>>>            WebSet pbVisible of oWarning to True
37347>>>        End
37347>>>>
37347>>>    End_Procedure
37348>>>    
37348>>>    Procedure OnSubmit
37351>>>        Send DoLogin
37352>>>    End_Procedure
37353>>>    
37353>>>    Procedure OnLoad
37356>>>        String sPrevStateHash sView
37356>>>        
37356>>>        Forward Send OnLoad
37358>>>        
37358>>>        //  Store the current state so we can go back to that later (only if it points to a different view)
37358>>>        Get StateHash of ghoWebApp to sPrevStateHash
37359>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37360>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37362>>>            WebSet psPrevStateHash to sPrevStateHash
37363>>>        End
37363>>>>
37363>>>        
37363>>>    End_Procedure
37364>>>    
37364>>>    Procedure OnBeforeShow
37367>>>        //  Hide header & apply nice background style
37367>>>        Send HideHeader to ghoWebApp
37368>>>        WebSet psCSSClass of ghoWebApp to "LoginBackground"
37369>>>    End_Procedure
37370>>>    
37370>>>End_Object
