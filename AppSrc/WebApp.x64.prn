38287>>>    Procedure SetActionButtons
38290>>>        tWebNavigateData NavigateData
38290>>>        tWebNavigateData NavigateData
38290>>>        Boolean bHasRecord
38290>>>        Handle hoDD
38290>>>
38290>>>        Get Server to hoDD
38291>>>        Get GetNavigateData to NavigateData
38292>>>        Get HasRecord of hoDD to bHasRecord
38293>>>
38293>>>        // let's hide all buttons and then Show the ones we want
38293>>>        WebSet pbRender of oEditBtn to False
38294>>>        WebSet pbRender of oSaveBtn to False
38295>>>        WebSet pbRender of oCancelChangesBtn to False
38296>>>        WebSet pbRender of oDeleteBtn to False
38297>>>
38297>>>        If (NavigateData.bReadOnly) Begin
38299>>>            WebSet pbRender of oEditBtn to True
38300>>>        End
38300>>>>
38300>>>        Else Begin
38301>>>            WebSet pbRender of oSaveBtn to True
38302>>>            WebSet pbRender of oCancelChangesBtn to True
38303>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38304>>>        End
38304>>>>
38304>>>    End_Procedure
