37244>>>    
37244>>>    Procedure DoLogin
37247>>>        String sLoginName sPassword sPrevStateHash
37247>>>        Boolean bResult
37247>>>        
37247>>>        WebGet psValue of oLoginName to sLoginName
37248>>>        WebGet psValue of oPassword to sPassword
37249>>>        
37249>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37250>>>        
37250>>>        If (bResult) Begin
37252>>>            Send Hide of oLogin
37253>>>            Send ShowHeader of ghoWebApp
37254>>>            WebSet psCSSClass of ghoWebApp to ""
37255>>>            
37255>>>            WebGet psPrevStateHash to sPrevStateHash
37256>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37257>>>            
37257>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37257>>>            WebSet psValue of oLoginName to ""
37258>>>            WebSet psValue of oPassword  to ""
37259>>>            WebSet pbVisible of oWarning to False
37260>>>        End
37260>>>>
37260>>>        Else Begin
37261>>>            WebSet pbVisible of oWarning to True
37262>>>        End
37262>>>>
37262>>>    End_Procedure
37263>>>    
37263>>>    Procedure OnSubmit
37266>>>        Send DoLogin
37267>>>    End_Procedure
37268>>>    
37268>>>    Procedure OnLoad
37271>>>        String sPrevStateHash sView
37271>>>        
37271>>>        Forward Send OnLoad
37273>>>        
37273>>>        //  Store the current state so we can go back to that later (only if it points to a different view)
37273>>>        Get StateHash of ghoWebApp to sPrevStateHash
37274>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37275>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37277>>>            WebSet psPrevStateHash to sPrevStateHash
37278>>>        End
37278>>>>
37278>>>        
37278>>>    End_Procedure
37279>>>    
37279>>>    Procedure OnBeforeShow
37282>>>        //  Hide header & apply nice background style
37282>>>        Send HideHeader to ghoWebApp
37283>>>        WebSet psCSSClass of ghoWebApp to "LoginBackground"
37284>>>    End_Procedure
37285>>>    
37285>>>End_Object
