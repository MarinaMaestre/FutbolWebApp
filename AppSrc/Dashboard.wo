Use cWebView.pkg
Use cWebPanel.pkg
Use cWebGroup.pkg
Use cWebHtmlBox.pkg

Object oDashboard is a cWebView
    
    // Registro de rutas para navegación Drill-down (Evita error 404)
    WebRegisterPath ntNavigateForward oEntrenador
    WebRegisterPath ntNavigateForward oEquipo
    WebRegisterPath ntNavigateForward oJugador
    WebRegisterPath ntNavigateForward oLiga

    Set piMaxWidth to 1024
    Set psCaption to "Dashboard"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"
    
    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24
        
        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 16
    
        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 24
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12
            Set psCSSClass to "TilesGroup"
    
            // TILE 1: ENTRENADORES
            Object oWelcomeTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
    
                Procedure OnLoad
                    Send UpdateHTML ('<div class="WebCon_Sizer" data-ServerOnClick="open">' + ;
                                     '<div class="Tile_Title">Entrenadores</div>' + ;
                                     '<div class="Tile_Subtitle">Gestión de técnicos</div>' + ;
                                     '</div>')
                End_Procedure

                Procedure OnClick String sId String sParam
                    Send NavigateForward of oEntrenador Self
                End_Procedure
            End_Object
    
            // TILE 2: EQUIPOS
            Object oTile2 is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile LightAlternate"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="open"><div class="Tile_Title">Equipos</div><div class="Tile_Subtitle">Ver todos</div></div>'
                                
                Procedure OnClick String sId String sParam
                    Send NavigateForward of oEquipo Self
                End_Procedure
            End_Object
    
            // TILE 3: JUGADORES
            Object oTile3 is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Dark"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="open"><div class="Tile_Title">Jugadores</div><div class="Tile_Subtitle">Plantillas</div></div>'
    
                Procedure OnClick String sId String sParam
                    Send NavigateForward of oJugador Self
                End_Procedure
            End_Object
    
            // TILE 4: LIGAS
            Object oTile4 is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile DarkAlternate"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="open"><div class="Tile_Title">Ligas</div><div class="Tile_Subtitle">Competiciones</div></div>'
            
                Procedure OnClick String sId String sParam
                    Send NavigateForward of oLiga Self
                End_Procedure
            End_Object

        End_Object
    End_Object

End_Object