Use cWebView.pkg
Use cWebPanel.pkg
Use cWebGroup.pkg
Use cWebHtmlBox.pkg
Use SelectEntrenadorNuevo.wo
Use SelectJugadorNuevo.wo
Use SelectEquipoNuevo.wo
Use SelectLigaNuevo.wo

Object oDashboard is a cWebView
    // Metemos los registros AQUÍ dentro para que el F7 funcione
    WebRegisterPath ntNavigateForward oSelectEntrenadorNuevo
    WebRegisterPath ntNavigateForward oSelectJugadorNuevo
    WebRegisterPath ntNavigateForward oSelectEquipoNuevo
    WebRegisterPath ntNavigateForward oSelectLigaNuevo

    Set piMaxWidth to 1024
    Set psCaption to "Dashboard"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"
    
    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24
        
        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 24
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12
            Set psCSSClass to "TilesGroup"
    
            // TILE: ENTRENADORES
            Object oEntrenadoresTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
                Procedure OnLoad
                    Send UpdateHTML ('<div class="WebCon_Sizer" data-ServerOnClick="open"><div class="Tile_Title">Entrenadores</div></div>')
                End_Procedure
                Procedure OnClick String sId String sParam
                    Send NavigateForward of oSelectEntrenadorNuevo Self
                End_Procedure
            End_Object

            // TILE: JUGADORES
            Object oJugadoresTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Dark"
                Procedure OnLoad
                    Send UpdateHTML ('<div class="WebCon_Sizer" data-ServerOnClick="open"><div class="Tile_Title">Jugadores</div></div>')
                End_Procedure
                Procedure OnClick String sId String sParam
                    Send NavigateForward of oSelectJugadorNuevo Self
                End_Procedure
            End_Object

            // TILE: EQUIPOS
            Object oEquiposTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
                Procedure OnLoad
                    Send UpdateHTML ('<div class="WebCon_Sizer" data-ServerOnClick="open"><div class="Tile_Title">Equipos</div></div>')
                End_Procedure
                Procedure OnClick String sId String sParam
                    Send NavigateForward of oSelectEquipoNuevo Self
                End_Procedure
            End_Object

            // TILE: LIGAS
            Object oLigasTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Dark"
                Procedure OnLoad
                    Send UpdateHTML ('<div class="WebCon_Sizer" data-ServerOnClick="open"><div class="Tile_Title">Ligas</div></div>')
                End_Procedure
                Procedure OnClick String sId String sParam
                    Send NavigateForward of oSelectLigaNuevo Self
                End_Procedure
            End_Object
        End_Object
    End_Object
End_Object